# PORT=4000
# CLIENT_ORIGIN=http://localhost:5173
# MONGODB_URI=mongodb://127.0.0.1:27017/pearedup
# VERIFICATION_TTL_MINUTES=15

# SMTP settings for real verification emails (Gmail SMTP example)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_real_email@gmail.com
# SMTP_PASS=your_16_char_gmail_app_password
# SMTP_FROM=PearedUp <your_real_email@gmail.com>

# Ollama chat settings (same defaults used in gala-chatbot)
# OLLAMA_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=llama3
# OLLAMA_TIMEOUT_MS=0
# OLLAMA_NUM_PREDICT=220
# OLLAMA_NUM_CTX=2048
# OLLAMA_NUM_THREAD=8

# Chat provider routing
# CHAT_PROVIDER=ollama-first

# Nebula (Gemini-compatible) settings
# NEBULA_API_KEY=your_nebula_or_google_ai_key
# NEBULA_MODEL=gemini-2.0-flash
# NEBULA_TIMEOUT_MS=10000
# NEBULA_METHOD=POST
# NEBULA_DATA_BASE_URL=https://api.utdnebula.com
